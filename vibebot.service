[Unit]
Description=Vibebot AI Assistant Gateway
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/mnt/hostgit/vibebot
EnvironmentFile=/mnt/hostgit/vibebot/.env
ExecStart=/mnt/hostgit/vibebot/vibebot gateway
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
