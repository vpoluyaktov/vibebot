# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs (leave empty to allow all)
# Get your ID by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=

# OpenRouter LLM Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (see https://openrouter.ai/models for options)
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free

# Comma-separated list of allowed models for /model command (REQUIRED)
# Working free models (as of 2026-02-26):
#   WITH TOOL SUPPORT (required for vibebot):
#     - arcee-ai/trinity-large-preview:free (recommended, 70B params)
#     - arcee-ai/trinity-mini:free (smaller, faster)
#   TEXT ONLY (no tool support, limited functionality):
#     - google/gemma-3-27b-it:free, google/gemma-3-12b-it:free, google/gemma-3-4b-it:free
# Note: Popular free models (mistral, llama, qwen) are heavily rate-limited (429 errors)
# Paid models for better reliability:
#   anthropic/claude-sonnet-4.5,openai/gpt-4-turbo,openai/gpt-4o-mini,google/gemini-pro-1.5
OPENROUTER_ALLOWED_MODELS=arcee-ai/trinity-large-preview:free,arcee-ai/trinity-mini:free

# Workspace Configuration
# Directory where bot stores memory and data
WORKSPACE_DIR=/home/ubuntu/.vibebot/workspace
