# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs (leave empty to allow all)
# Get your ID by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=

# OpenRouter LLM Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (see https://openrouter.ai/models for options)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Comma-separated list of allowed models for /model command (REQUIRED)
# Note: Free models on OpenRouter are often rate-limited or unavailable
# Recommended paid models (verify pricing at https://openrouter.ai/models):
# OPENROUTER_ALLOWED_MODELS=anthropic/claude-sonnet-4.5,anthropic/claude-3.5-sonnet,openai/gpt-4o,openai/gpt-4o-mini,google/gemini-pro-1.5,meta-llama/llama-3.3-70b-instruct
OPENROUTER_ALLOWED_MODELS=

# Workspace Configuration
# Directory where bot stores memory and data
WORKSPACE_DIR=/home/ubuntu/.vibebot/workspace
